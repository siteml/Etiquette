<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>etiq</AssemblyName>
    <ApplicationIcon>..\..\assets\etiq.ico</ApplicationIcon>
    <!-- Deployment target: single self-contained exe, no runtime install.
         Publish with: dotnet publish -c Release -r win-x64 -p:PublishSingleFile=true (add the self-contained switch)
    -->
  </PropertyGroup>

  <!-- BTW import module lives in the separate private repo `etiquette-btw`
       (sibling directory). Picked up automatically when present; the CLI
       builds without it (recon commands compiled out). See PROVENANCE.md. -->
  <PropertyGroup Condition="Exists('..\Etiq.Btw\Etiq.Btw.csproj') Or Exists('..\..\..\etiquette-btw\src\Etiq.Btw\Etiq.Btw.csproj')">
    <DefineConstants>$(DefineConstants);ETIQ_BTW</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Etiq.Core\Etiq.Core.csproj" />
    <!-- in-repo BTW module preferred; sibling private repo as fallback -->
    <ProjectReference Include="..\Etiq.Btw\Etiq.Btw.csproj"
                      Condition="Exists('..\Etiq.Btw\Etiq.Btw.csproj')" />
    <ProjectReference Include="..\..\..\etiquette-btw\src\Etiq.Btw\Etiq.Btw.csproj"
                      Condition="!Exists('..\Etiq.Btw\Etiq.Btw.csproj') And Exists('..\..\..\etiquette-btw\src\Etiq.Btw\Etiq.Btw.csproj')" />
  </ItemGroup>

</Project>
